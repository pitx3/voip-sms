{
  "name": "voipms-sms-desktop",
  "version": "0.1.0",
  "type": "module",
  "description": "Linux SMS/MMS desktop app for Voip.ms",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "NODE_ENV=development electron .",
    "live-api": "NODE_ENV=development USE_MOCK_VOIPMS=false electron .",
    "live-db": "NODE_ENV=development USE_MOCK_DB=false electron .",
    "start": "electron .",
    "test": "vitest run tests/unit",
    "test-all": "vitest run --exclude 'tests/integration/unsafe/'",
    "test-intg": "vitest run tests/integration/ --exclude 'tests/integration/unsafe/'",
    "test-unsafe": "vitest run tests/integration/unsafe/",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild"
  },
  "keywords": [
    "sms",
    "mms",
    "voip.ms",
    "electron",
    "linux"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-rebuild": "^3.2.9",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
