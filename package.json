{
  "name": "voipms-sms-desktop",
  "version": "0.1.0",
  "type": "module",
  "description": "Linux SMS/MMS desktop app for Voip.ms",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "NODE_ENV=development electron .",
    "start": "electron .",
    "test": "vitest",
    "test:watch": "jest --watch",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild"
  },
  "keywords": [
    "sms",
    "mms",
    "voip.ms",
    "electron",
    "linux"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-rebuild": "^3.2.9",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
